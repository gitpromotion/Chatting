gcc multi_thread_server.c -o MULTI_THREAD_SERVER
gcc multi_thread_client.c -o MULTI_THREAD_CLIENT

# 새로운 터미널 창을 열고
cd -chatting
ls -l # MULTI_THREAD_SERVER, MULTI_THREAD_CLIENT 가 보이고 이름이 초록색이거나 *가 붙어 있으면 실행파일 맞음

./MULTI_THREAD_SERVER 9999

cd chatting
./MULTI_THREAD_CLIENT 127.0.0.1 9999 홍길동

./MULTI_THREAD_CLIENT 127.0.0.1 9999 김철수
